{
  "manifest_version": 3,
  "name": "4ndr0serviceguard",
  "short_name": "4ndr0guard",
  "version": "7.1.1",
  "description": "Ghost Protocol v7: Stealth Service Worker, WebSocket & SharedWorker firewall with purge-on-load, live approval UI and enforced whitelist.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "tabs"
  ],
  "externally_connectable": {
    "matches": ["<all_urls>"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ghost_bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["ghost_core_v7.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
