{
  "manifest_version": 3,
  "name": "4ndr0serviceguard",
  "short_name": "4ndr0guard",
  "version": "5.0.0",
  "description": "Ghost Protocol: Interactive Service Worker and WebSocket Firewall Gatekeeper.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["pacifier_v5.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/disabled16.png",
      "48": "icons/disabled48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
